---
# Homepage configuration
# See https://fontawesome.com/search for icons options

title: "Demo dashboard"
subtitle: "Hommerized"
logo: "logo.png"
# icon: "fas fa-skull-crossbones" # Optional icon

header: true
footer: '<p><a href="https://github.com/AntKinton/hommerized">Hommerized</a> version 26.05.4 - A fork of homer with additional features made with <span class="has-text-danger">❤️</span> and powered by <a href="https://bulma.io/">bulma</a>, <a href="https://vuejs.org/">vuejs</a> & <a href="https://fontawesome.com/">font awesome</a> // Forked from <a href="https://github.com/bastienwirtz/homer"><i class="fab fa-github-alt"></i></a></p>' # you can set it to false

columns: 3
connectivityCheck: false

# Optional theme customization
theme: default

# Optional theme customization (color overrrides)
# overrrides can also be done using CSS vars 
colors:
  light:
    highlight-primary: "#3367d6"
    highlight-secondary: "#4285f4"
    highlight-hover: "#5a95f5"
    background: "#f5f5f5"
    card-background: "#ffffff"
    text: "#363636"
    text-header: "#ffffff"
    text-title: "#303030"
    text-subtitle: "#424242"
    card-shadow: rgba(0, 0, 0, 0.1)
    link: "#3273dc"
    link-hover: "#363636"
  dark:
    highlight-primary: "#3367d6"
    highlight-secondary: "#4285f4"
    highlight-hover: "#5a95f5"
    background: "#131313"
    card-background: "#2b2b2b"
    text: "#eaeaea"
    text-header: "#ffffff"
    text-title: "#fafafa"
    text-subtitle: "#f5f5f5"
    card-shadow: rgba(0, 0, 0, 0.4)
    link: "#3273dc"
    link-hover: "#ffdd57"

# Optional navbar
# links: [] # Allows for navbar (dark mode, layout, and search) without any links
links:
  - name: "Contribute"
    icon: "fab fa-github"
    url: "https://github.com/AntKinton/hommerized"
    target: "_blank" # optional html a tag target attribute
  - name: "Wiki"
    icon: "fas fa-book"
    url: "https://www.wikipedia.org/"
  # this will link to a second hommerized page that will load config from additional-page.yml and keep default config values as in config.yml file
  # see url field and assets/additional-page.yml.dist used in this example:
  #- name: "another page!"
  #  icon: "fas fa-file-alt"
  #  url: "#additional-page" 

# Optional: enable periodic refresh for all smart cards that implements it (unless overriden at service configuration level).
updateIntervalMs: 30000 # interval in milliseconds, minimum is 1000 (1s). Remove or set to 0 to disable. Can be overriden at service level. (default disabled)

# Optional message
message:
  style: "is-dark" # See https://bulma.io/documentation/components/message/#colors for styling options.
  title: "Hommerized Demo!"
  icon: "fa fa-grin"
  content: "Welcome to Hommerized, here you'll find some documentation on how to get started and use this dashboard. Also some examples of how you can organize access to your main webs or services on this dashboard. Feel free to explore and customize it to your needs."

# Services
# First level array represent a group.
# Leave only a "items" key if not using group (group name, icon & tagstyle are optional, section separation will not be displayed).
services:
  - name: "Getting Started"
    icon: "fas fa-rocket"
    items:
      - name: "Initial Setup"
        icon: "fa-solid fa-download"
        subtitle: "Start using Hommerized"
        tag: "setup"
        url: "https://github.com/AntKinton/hommerized?tab=readme-ov-file#get-started"
      - name: "Configuration"
        icon: "fa-solid fa-sliders"
        subtitle: "Configuration options documentation"
        tag: "setup"
        url: "https://github.com/AntKinton/hommerized/blob/main/docs/configuration.md"
      - name: "Layout Views"
        icon: "fa-solid fa-columns"
        subtitle: "Layout views documentation"
        tag: "setup"
        url: "https://github.com/AntKinton/hommerized/blob/main/docs/layout.md"

  - name: "Groupware Services"
    icon: "fas fa-layer-group"
    items:
      - name: "Hub/Nextcloud"
        type: "Generic"
        logo: "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/nextcloud.png"
        url: "https://hub.your-domain.com"
        target: "_blank"
      - name: "Element/Matrix"
        type: "Generic"
        logo: "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/element.png"
        url: "https://element.your-domain.com"
        target: "_blank"

  - name: "Security & Vault Services"
    icon: "fas fa-shield-alt"
    items:
      - name: "Vaultwarden"
        type: "Generic"
        logo: "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/vaultwarden.png"
        endpoint: "/api/health-vault"
        url: "https://vault.your-domain.com"
        target: "_blank"

  - name: "Development Centre"
    icon: "fas fa-code"
    items:
      - name: "Forgejo"
        type: "Generic"
        logo: "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/forgejo.png"
        endpoint: "/api/health-forgejo"
        url: "https://forgejo.your-domain.com"
        target: "_blank"

  - name: "More documentation"
    icon: "fas fa-book"
    items:
      - name: "Theming"
        icon: "fa-solid fa-palette"
        subtitle: "Customize Hommerized appearance"
        tag: "theming"
        url: "https://github.com/AntKinton/hommerized/blob/main/docs/theming.md"
      - name: "Smart cards"
        icon: "fa-solid fa-palette"
        subtitle: "Displays dynamic information or actions."
        tag: "setup"
        url: "https://github.com/AntKinton/hommerized/blob/main/docs/customservices.md"
      - name: "Dashboard icons"
        icon: "fa-solid fa-icons"
        subtitle: "Dashboard icons"
        tag: "setup"
        url: "https://github.com/walkxcode/dashboard-icons"
      - name: "Module extras"
        icon: "fa-solid fa-plug"
        subtitle: "Module extras"
        tag: "setup"
        url: "https://github.com/AntKinton/hommerized/blob/main/docs/module-extras.md"
      - name: "Groups policy"
        icon: "fa-solid fa-users"
        subtitle: "Group based access control"
        tag: "setup"
        url: "https://github.com/AntKinton/hommerized/blob/main/docs/module-policy.md"
      - name: "Advanced Configuration"
        icon: "fa-solid fa-sliders"
        subtitle: "Advanced Configuration"
        tag: "setup"
        url: "https://github.com/AntKinton/hommerized/blob/main/docs/advanced-configuration.md"
      - name: "Podman"
        icon: "fa-solid fa-boxes-stacked"
        subtitle: "Podman"
        tag: "container"
        url: "https://github.com/AntKinton/hommerized/blob/main/docs/podman.md"